<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= book.title %> | Bookify</title>
  <%- include('../partials/header') %>
</head>

<body>
  <main class="book-detail-wrapper">
    <div class="book-detail-container">

      <!-- Book Image -->
      <div class="book-detail-image">
        <img src="<%= book.coverImage %>" alt="<%= book.title %> Cover" />
      </div>

      <!-- Book Info -->
      <div class="book-detail-content">
        <h1><%= book.title %></h1>
        <h3>By <%= book.author %></h3>
        <p class="price">₹ <%= book.price %></p>

        <ul class="book-meta">
          <li><strong>Genre:</strong> <%= book.genre %></li>
          <li><strong>Language:</strong> <%= book.language %></li>
          <li><strong>Pages:</strong> <%= book.pages %></li>
        </ul>

        <p class="description"><%= book.description %></p>

        <!-- Buttons -->
        <div class="action-buttons">
          <% if (user) { %>
            <form action="/add-to-cart/<%= book._id %>" method="POST">
              <button type="submit" class="btn">🛒 Add to Cart</button>
            </form>
            <form action="/buy-now/<%= book._id %>" method="POST">
              <button type="submit" class="btn btn-secondary">⚡ Buy Now</button>
            </form>
            <!-- <a href="/checkout/<%= book._id %>" class="btn btn-secondary">⚡ Buy Now</a> -->
          <% } else { %>
            <a href="/auth/login" class="btn">Login to Buy</a>
            <a href="/auth/login" class="btn btn-secondary">Add to Cart</a>
          <% } %>
        </div>
      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>
