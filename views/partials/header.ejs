<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Bookify | Home</title>
<link rel="stylesheet" href="/css/style.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<!-- Navbar -->
<nav class="navbar">
  <div class="logo">Bookify</div>

  <!-- ✅ Search box (always visible) -->
  <div class="search-box">
    <input type="text" placeholder="Search Books By name author title." />
  </div>

  <!-- ✅ Hamburger button (only visible on mobile) -->
  <div class="hamburger" onclick="toggleMenu()">
    <i class="fas fa-bars"></i>
  </div>

  <!-- ✅ Navigation links -->
  <div class="nav-icons">
    <% if (user) { %>
      <a href="/cart"><i class="fas fa-cart-shopping"></i> Cart</a>
      <a href="/auth/logout" class="btn1">Logout</a>
      <a href="/auth/profile" class="signup"><i class="fas fa-user"></i> Profile</a>
    <% } else { %>
      <a href="/auth/login" class="btn1">Login</a>
      <a href="/auth/signup" class="signup"><i class="fas fa-user"></i> Sign Up</a>
    <% } %>
  </div>
</nav>

<!-- ✅ Secondary Navbar -->
<nav class="navbar-2">
  <a href="/" class="login">Home</a>
  <a href="/about" class="login">About Us</a>
  <a href="/contact" class="login">Contact Us</a>
</nav>

<!-- ✅ Hamburger Script -->
<script>
  function toggleMenu() {
    document.querySelector('.nav-icons').classList.toggle('active');
  }
</script>
