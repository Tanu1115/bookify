<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Bookify | Home</title>
<link rel="stylesheet" href="/css/style.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<!-- Navbar -->
<nav class="navbar">
  <div class="logo">Bookify</div>
  <div class="search-bar">
    <form action="/search" method="GET" autocomplete="off" style="position: relative;">
      <input type="text" id="searchBox" name="q" placeholder="Search books..." />
      <ul id="suggestionsList" class="suggestions"></ul>
    <button type="submit"><i class="fas fa-search"></i></button>
    </form>
  </div>

  <div class="nav-icons">
    <% if (user) { %>
      <a href="/cart"><i class="fas fa-cart-shopping"></i> Cart</a>
      <a href="/auth/logout" class="btn1">Logout</a>
      <a href="/auth/profile" class="signup"><i class="fas fa-user"></i> Profile</a>
    <% } else { %>
      <a href="/auth/login" class="btn1">Login</a>
      <a href="/auth/signup" class="signup"><i class="fas fa-user"></i> Sign Up</a>
    <% } %>
  </div>
</nav>

<nav class="navbar-2">
  <a href="/" class="login">Home</a>
  <a href="/about" class="login">About Us</a>
  <a href="/contact" class="login">Contact us</a>
</nav>

<!-- Link to the search script -->
<script src="/search.js" defer></script> <!-- ✅ Remove 'public/' -->

